# Postgres (used by docker-compose to build DATABASE_URL automatically)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Only needed for local dev without docker-compose (compose builds this for you from the vars above)
DATABASE_URL=

# Telegram bot token used for admin notifications
TELEGRAM_BOT_TOKEN=

# Google reCAPTCHA v3 keys
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Secret used to sign admin JWT auth cookies
JWT_SECRET=

# Groq API key (used by the chat bot)
GROQ_API_KEY=
